{
  "manifest_version": 3,
  "name": "Claude 잔액 키트",
  "short_name": "Claude 잔액",
  "version": "1.0.0",
  "description": "툴바 버튼을 누르면 Anthropic 콘솔의 크레딧 잔액을 확인하고, 사용액과 잔액 부족을 알려 줍니다.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": ["https://api.anthropic.com/*", "https://platform.claude.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude 잔액 확인",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://platform.claude.com/settings/billing*"],
      "js": ["lib/billing-parse.js", "content-billing.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
